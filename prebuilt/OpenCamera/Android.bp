//
// Open Camera (net.sourceforge.opencamera), F-Droid build 1.56.2 (versionCode 96)
// https://f-droid.org/repo/net.sourceforge.opencamera_96.apk
// sha256 ca5672ca8c7174554ca0b07b5b26e505817a05142f571cf2abe67e790c30249c
// License: GPL-3.0-or-later, source at https://sourceforge.net/projects/opencamera/
//
// Replaces Aperture: CameraX goes through the camera2 legacy shim, which only
// offers HAL1 preview sizes (max 720p) and records by GL-copying preview
// frames. Open Camera uses the old camera API, so recording takes the HAL's
// zero-copy FIMC2 -> MFC path and offers 1080p.
//

android_app_import {
    name: "OpenCamera",
    apk: "OpenCamera.apk",
    // Keep the F-Droid signature so F-Droid updates install over it
    presigned: true,
    // targetSdk 36: v2-signed, must not be touched by the build
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: [
        "Aperture",
        "ApertureFrameworksBaseOverlay",
        "ApertureLensLauncher",
    ],
}
