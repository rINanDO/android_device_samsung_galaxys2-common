allow system_app sysfs_display:file { write getattr open };
allow system_app sysfs_display:dir search;
allow system_app method_trace_data_file:file { read unlink execute };
allow system_app proc_pagetypeinfo:file { getattr open read };
allow system_app sysfs_zram:dir search;
allow system_app sysfs_zram:file { getattr open read };
allow system_app wificond:binder call;
allow system_app ion_device:chr_file write;
allow system_app apexd:binder call;
allow system_app installd:binder call;
allow system_app netd:binder call;
allow system_app vold:binder call;
allow system_app hal_light_default:binder call;

# After a developer option changes, Settings pokes every registered service
# to reload system properties; these don't need it.
dontaudit system_app {
  hal_vibrator_default
  hal_wifi_supplicant_default
}:binder call;
